# Control de versiones
.git
.gitignore

# Dependencias y builds locales (se recrean dentro de la imagen)
node_modules
**/node_modules
client/dist
server/coverage

# Datos locales de la base (se usa el volumen / la capa del contenedor)
server/data
*.db
